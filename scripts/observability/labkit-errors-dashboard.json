    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Failed requests over time, by model",
      "description": "Failed requests per model over time: TraceQL count_over_time() by (span.model) on agent.model.request spans, in 10-minute steps. Failed attempts that a fallback recovered are counted in the table above.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.outcome=\"failed\"} | count_over_time() by (span.model)",
          "metricsQueryType": "range",
          "limit": 50,
          "step": "10m"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Retries, by reason",
      "description": "Requests retried within one attempt, by the error that caused the retry (log lines provider.request.retried, field fields.reason): LogQL count_over_time. Retries have no span of their own; the attempt span shows only the final result.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (reason) (count_over_time({service_name=~\"$service\"} |= \"provider.request.retried\" | json reason=\"fields.reason\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
