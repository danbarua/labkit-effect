                  {
                    "title": "Open in the session dashboard",
                    "url": "/d/labkit-session/labkit-session?var-trace=${__data.fields.traceIdHidden}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Span ID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Span"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "When",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=~\"agent.model.request|agent.model.attempt\" && span.outcome=\"failed\"} | select(span.provider, span.model, span.error_kind, span.http_status, span.failure, span.error_signature, span.cwd) with (most_recent=true)",
          "limit": 200,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Start time": 0,
              "Name": 1,
              "model": 2,
              "provider": 3,
              "error_kind": 4,
              "http_status": 5,
              "failure": 6,
              "error_signature": 7,
              "cwd": 8,
              "Trace Name": 9,
              "Span ID": 10
            },
            "excludeByName": {
              "Trace Service": true,
              "Duration": true
            },
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Failed and retried requests (log lines)",
      "description": "The log lines of failed requests (provider.request.failed, with the provider's full error and whether it is retryable) and of retries (provider.request.retried: retry n of m, the wait, the reason). Expand a line for its trace link.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$service\"} |~ \"provider\\\\.request\\\\.(failed|retried)\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
