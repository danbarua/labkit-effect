{
  "uid": "labkit-agent",
  "title": "labkit agent",
  "description": "Model latency, token use, tool runs, sessions and warnings of the labkit harness. Source: scripts/observability/labkit-dashboard.json.",
  "tags": [
    "labkit"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"labkit-.*\"}, service)",
          "refId": "service"
        },
        "includeAll": true,
        "allValue": "labkit-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Time to first token, by model",
      "description": "From the start of a model attempt to its first thinking or text: the attempts' ttft_ms, from Tempo.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && span.ttft_ms > 0.0} | avg_over_time(span.ttft_ms) by (span.model)",
          "metricsQueryType": "range",
          "limit": 20
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && span.ttft_ms > 0.0} | max_over_time(span.ttft_ms) by (span.model)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Model attempt duration, by model",
      "description": "A whole response, from its request to its last event: the agent.model.attempt spans, from Tempo.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.attempt\"} | quantile_over_time(duration, .5, .95) by (span.model)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens, by model",
      "description": "Input and output tokens of each response, summed: the agent.model.request spans, from Tempo.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.input_tokens > 0} | sum_over_time(span.input_tokens) by (span.model)",
          "metricsQueryType": "range",
          "limit": 20
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.output_tokens > 0} | sum_over_time(span.output_tokens) by (span.model)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tool runs, by tool",
      "description": "The agent.tool.run spans, counted, from Tempo.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.tool.run\"} | count_over_time() by (span.tool)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Span duration by operation, p95",
      "description": "Tempo's span metrics for the spans of sessions, turns, requests, attempts, tool runs, games and HTTP calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_name=~\"agent.*|zork.*|http.client.*\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Sessions and games",
      "description": "The latest sessions (agent.session) and zork games (zork.game). Select a trace to see its timeline.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && (name=\"agent.session\" || name=\"zork.game\")}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Log lines at warning level and above.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$service\", detected_level=~\"warn|error|fatal\"}"
        }
      ]
    }
  ]
}
