    {
      "id": 4,
      "type": "barchart",
      "title": "Daily burn by provider: $burn",
      "description": "Per day in the dashboard's time zone, for each provider, chosen by the Burn variable: requests (agent.model.request spans), tokens (span.input_tokens + span.output_tokens) or cost (span.cost_usd of priced responses, in USD). Summed from Tempo's 10-minute steps; the step still in progress is missing.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "requests",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && ${burn} != nil} | count_over_time() by (span.provider)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        },
        {
          "refId": "input",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.input_${burn:text} != nil} | sum_over_time(span.input_${burn:text}) by (span.provider)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        },
        {
          "refId": "output",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.output_${burn:text} != nil} | sum_over_time(span.output_${burn:text}) by (span.provider)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        },
        {
          "refId": "cost",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.${burn:text}_usd != nil} | sum_over_time(span.${burn:text}_usd) by (span.provider)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "YYYY-MM-DD",
            "useTimezone": true
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Time": {
                "operation": "groupby",
                "aggregations": []
              },
              "Metric": {
                "operation": "groupby",
                "aggregations": []
              },
              "Value": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              }
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "Metric",
            "rowField": "Time",
            "valueField": "Value (sum)",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Time\\Metric": "Time"
