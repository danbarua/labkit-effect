      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency: $model",
      "description": "For the model chosen in the Model variable, per 10 minutes: the median (p50) and 95th percentile (p95) duration of its agent.model.request spans, and the mean of their span.ttft_ms (right axis). Tempo returns 0 for a step without spans; those points are left out.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "duration",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.model = \"$model\"} | quantile_over_time(duration, .5, .95)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        },
        {
          "refId": "ttft",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.ttft_ms != nil && span.model = \"$model\"} | avg_over_time(span.ttft_ms)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TTFT (mean)"
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
