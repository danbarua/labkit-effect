    {
      "id": 3,
      "type": "table",
      "title": "By model",
      "description": "For each provider and model, over agent.model.request spans: requests; cost (span.cost_usd of priced responses; empty when none was priced); tokens (input + output); cache rate (cache read ÷ (uncached input + cache read)); errors (failed ÷ requests); tokens/s (mean of span.tokens_per_second); TTFT (mean of span.ttft_ms). nil = spans without a model attribute (written by tests or before it existed). Not here from omp's model table: the trend sparkline (the chart above), cache savings (needs the uncached price of cache reads on the span) and first and last seen (needs Tempo's range query, which cannot sit in a table of expressions).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "Requests_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\"} | count_over_time() by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "Requests",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Requests_q",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        },
        {
          "refId": "Cost_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.cost_usd != nil && span.priced = true} | sum_over_time(span.cost_usd) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "Cost",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Cost_q",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        },
        {
          "refId": "in_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.input_tokens != nil} | sum_over_time(span.input_tokens) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "in",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "in_q",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "out_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.output_tokens != nil} | sum_over_time(span.output_tokens) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "out",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "out_q",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "Tokens",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$in + $out"
        },
        {
          "refId": "cr_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.cache_read_tokens != nil} | sum_over_time(span.cache_read_tokens) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "cr",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "cr_q",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "unc_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.uncached_input_tokens != nil} | sum_over_time(span.uncached_input_tokens) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "unc",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "unc_q",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "CacheRate",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$cr / ($unc + $cr)"
        },
        {
          "refId": "f_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.outcome = \"failed\"} | count_over_time() by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "f",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "f_q",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "Errors",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$f / $Requests"
        },
        {
          "refId": "TokensPerSecond_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.tokens_per_second != nil} | avg_over_time(span.tokens_per_second) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "TokensPerSecond",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "TokensPerSecond_q",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        },
        {
          "refId": "TTFT_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.ttft_ms != nil} | avg_over_time(span.ttft_ms) by (span.provider, span.model)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "TTFT",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "TTFT_q",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "span.model": 0,
              "span.provider": 1,
              "Requests": 2,
              "Cost": 3,
              "Tokens": 4,
              "CacheRate": 5,
              "Errors": 6,
              "TokensPerSecond": 7,
              "TTFT": 8
            },
            "renameByName": {
              "span.model": "Model",
              "span.provider": "Provider",
              "span.cwd": "Folder",
              "CacheRate": "Cache rate",
              "TokensPerSecond": "Tokens/s",
              "TTFT": "TTFT"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "span.model"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^\"(.*)\"$",
                      "result": {
                        "text": "$1",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span.provider"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^\"(.*)\"$",
                      "result": {
                        "text": "$1",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
