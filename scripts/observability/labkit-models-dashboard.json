{
  "uid": "labkit-models",
  "title": "labkit models",
  "description": "Requests, cost, tokens, cache, errors and speed of each model the labkit harness asked, from Tempo's agent.model.request spans; omp's stats Models. Source: scripts/observability/labkit-models-dashboard.json.",
  "tags": [
    "labkit"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "labkit"
      ],
      "asDropdown": true,
      "title": "labkit dashboards",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"labkit-.*\"}, service)",
          "refId": "service"
        },
        "includeAll": true,
        "allValue": "labkit-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "description": "The model of the latency and throughput charts: the models that reported tokens (Prometheus agent_model_tokens) in the range.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(agent_model_tokens{service_name=~\"$service\"}, model)",
          "refId": "model"
        },
        "definition": "label_values(agent_model_tokens{service_name=~\"$service\"}, model)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Request share per day, by model",
      "description": "Each model's share of the day's agent.model.request spans, per day in the dashboard's time zone (the tooltip shows the counts). Counted by Tempo in 10-minute steps, summed per day; the step still in progress is missing.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\"} | count_over_time() by (span.provider, span.model)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "YYYY-MM-DD",
            "useTimezone": true
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Time": {
                "operation": "groupby",
                "aggregations": []
              },
              "Metric": {
                "operation": "groupby",
                "aggregations": []
              },
              "Value": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              }
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "Metric",
            "rowField": "Time",
            "valueField": "Value (sum)",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Time\\Metric": "Time"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\{span\\.model=\"(.*)\", span\\.provider=\"(.*)\"\\}$",
            "renamePattern": "$2/$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Time",
        "stacking": "percent",
        "orientation": "vertical",
        "showValue": "never",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "barWidth": 0.9,
        "groupWidth": 0.7,
        "fullHighlight": false,
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Requests per day, by model",
