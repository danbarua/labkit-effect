          "metricsQueryType": "instant",
          "limit": 50
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "TTFT average",
      "description": "The average time to first token of the attempt that answered each request (span.ttft_ms): TraceQL avg_over_time. omp shows the median; Tempo 3.0 computes quantiles of span duration only, not of an attribute such as ttft_ms.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.ttft_ms != nil} | avg_over_time(span.ttft_ms)",
          "metricsQueryType": "instant",
          "limit": 50
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Request log",
      "description": "The latest model requests (agent.model.request spans, newest first; Tempo search, at most 200 sessions and 100 requests in each). Input is the uncached input (input minus cache read and cache write). Cost is blank when the model has no price or the request failed: it is never shown as 0. Duration is the whole request, fallbacks included; TTFT is that of the attempt that answered. Status is the request's outcome, with the provider's stop reason. \"Span\" opens the trace at this request: expand its agent.model.attempt span and choose \"Logs for this span\" to see its captured bodies, each with a \"Body\" link (the capture server, bun run observability:captures, must be running). \"Session\" opens the session dashboard. Not shown, unlike omp's request panel: the output message (it is in the captured response body) and premium requests.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Start time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "When"
              },
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "model"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Model"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "provider"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Provider"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cwd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Project"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uncached_input_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Input"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_read_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cache read"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_write_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cache write"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Output"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cost"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ttft_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TTFT"
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "outcome"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "responded": {
                        "text": "responded",
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "text": "failed",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stop"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Stop"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_kind"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Error kind"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Failure"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace Name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Session"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in the session dashboard",
                    "url": "/d/labkit-session/labkit-session?var-trace=${__data.fields.traceIdHidden}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Span ID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Span"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "When",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\"} | select(span.provider, span.model, span.cwd, span.uncached_input_tokens, span.cache_read_tokens, span.cache_write_tokens, span.output_tokens, span.cost_usd, span.ttft_ms, span.outcome, span.stop, span.error_kind, span.failure) with (most_recent=true)",
          "limit": 200,
          "spss": 100,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Start time": 0,
              "model": 1,
              "provider": 2,
              "cwd": 3,
              "uncached_input_tokens": 4,
