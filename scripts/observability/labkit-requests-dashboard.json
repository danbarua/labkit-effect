{
  "uid": "labkit-requests",
  "title": "labkit requests",
  "description": "omp's Requests view: the request log, with links from each request to its trace and its captured bodies. Source: scripts/observability/labkit-requests-dashboard.json.",
  "tags": [
    "labkit"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "labkit dashboards",
      "type": "dashboards",
      "tags": [
        "labkit"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"labkit-.*\"}, service)",
          "refId": "service"
        },
        "includeAll": true,
        "allValue": "labkit-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "description": "Model requests (agent.model.request spans) in the range: TraceQL count_over_time.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\"} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed",
      "description": "Requests whose outcome is failed (every attempt of the fallback chain failed): TraceQL count_over_time.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.outcome=\"failed\"} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "description": "Failed requests divided by all requests (a Grafana expression over two TraceQL counts). Requests recorded before outcome was set count as not failed.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\"} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.outcome=\"failed\"} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "All",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "Failed",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "B",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "Error rate",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "${Failed} / ${All}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens",
      "description": "Input tokens (cache read and cache write included) plus output tokens of every request: TraceQL sum_over_time, added by a Grafana expression.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.input_tokens != nil} | sum_over_time(span.input_tokens)",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.output_tokens != nil} | sum_over_time(span.output_tokens)",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "Input",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "Output",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "B",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "Tokens",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "${Input} + ${Output}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "API-equivalent cost",
      "description": "The cost of priced requests (span.cost_usd, at the list price labkit knows for the model): TraceQL sum_over_time. Unpriced and failed requests carry no cost and are not counted.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.cost_usd != nil} | sum_over_time(span.cost_usd)",
          "metricsQueryType": "instant",
          "limit": 50
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unpriced",
      "description": "Requests answered by a model with no known price (span.priced=false): their cost is unknown, not 0. TraceQL count_over_time.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
