    {
      "id": 12,
      "type": "table",
      "title": "Tools in this trace",
      "description": "Per tool: calls, failures (outcome not Succeeded), total, average and longest run time. TraceQL metrics by (span.tool) over the trace's agent.tool.run spans, reduced and joined by Grafana expressions. Failures is 0 when no run of the tool failed (no failure series).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^\"(.*)\"$",
                "result": {
                  "text": "$1",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "span.tool"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tool"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Average time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Longest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Total time",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:id=\"$trace\" && name=\"agent.tool.run\"} | count_over_time() by (span.tool)",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:id=\"$trace\" && name=\"agent.tool.run\" && span.outcome != nil && span.outcome != \"Succeeded\"} | count_over_time() by (span.tool)",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:id=\"$trace\" && name=\"agent.tool.run\"} | sum_over_time(duration) by (span.tool)",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:id=\"$trace\" && name=\"agent.tool.run\"} | max_over_time(duration) by (span.tool)",
          "metricsQueryType": "instant",
          "limit": 50,
          "hide": true
        },
        {
          "refId": "Calls",
          "datasource": {
            "type": "__expr__",
