{
  "uid": "labkit-tools",
  "title": "labkit tools",
  "description": "omp's Tools view: tool calls, failures, argument and result sizes, by tool and by tool and model. Source: scripts/observability/labkit-tools-dashboard.json.",
  "tags": [
    "labkit"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "labkit dashboards",
      "type": "dashboards",
      "tags": [
        "labkit"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"labkit-.*\"}, service)",
          "refId": "service"
        },
        "includeAll": true,
        "allValue": "labkit-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "refId": "model",
          "type": 1,
          "label": "model",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.attempt\" && span.tool_calls > 0}"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "description": "Models whose responses asked for tools (agent.model.attempt spans with tool_calls > 0)."
      }
    ]
  },
  "panels": [
    {
