    {
      "id": 11,
      "type": "table",
      "title": "By tool",
      "description": "Per tool: calls, failures (outcome not Succeeded), error rate, argument and result characters, result characters per call, total and average run time. Each column is a TraceQL metric by (span.tool) over the range (count_over_time, sum_over_time), reduced by Grafana expressions, joined on the tool, and divided by Grafana. Failures is 0 when no run of the tool failed (no failure series). Not shown, unlike omp: a trend per tool and the last use (TraceQL metrics give totals, not the time of the latest span), and attributed tokens and cost (see the note below).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^\"(.*)\"$",
                "result": {
                  "text": "$1",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "span.tool"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tool"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calls"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "0"
              }
