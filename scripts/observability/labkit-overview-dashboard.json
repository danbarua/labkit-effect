    {
      "id": 13,
      "type": "barchart",
      "title": "Activity per hour: $activity",
      "description": "Per hour, in the dashboard's time zone, chosen by the Activity variable. Requests: agent.model.request spans counted by outcome (nil = spans written before outcome existed). Tokens: span.input_tokens + span.output_tokens. Cost: span.cost_usd of priced responses, in USD. Tempo is asked in 10-minute steps and the steps are summed per hour; Tempo leaves out the step still in progress, so the latest minutes are missing. Hours without requests have no bar.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
