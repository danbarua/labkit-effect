{
  "uid": "labkit-overview",
  "title": "labkit overview",
  "description": "Cost, requests, tokens, cache and errors of the labkit harness's model requests, from Tempo's agent.model.request spans; omp's stats Overview. Source: scripts/observability/labkit-overview-dashboard.json.",
  "tags": [
    "labkit"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "labkit"
      ],
      "asDropdown": true,
      "title": "labkit dashboards",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"labkit-.*\"}, service)",
          "refId": "service"
        },
        "includeAll": true,
        "allValue": "labkit-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "activity",
        "label": "Activity",
        "type": "custom",
        "description": "What the activity chart shows.",
        "query": "requests : name,tokens : span.unset_tokens_gate,cost : span.unset_cost_gate",
        "current": {
          "text": "requests",
          "value": "name"
        },
        "options": [],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cost (API-equivalent)",
      "description": "What the priced responses would cost at the providers' list prices: the sum of span.cost_usd over agent.model.request spans with priced = true. Unpriced responses (priced = false: no price for the model, or no usage reported) are counted beside it, never as $0. omp's hint of what the cache saved would need each span to carry what its cache reads would have cost as uncached input.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "Cost_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.cost_usd != nil && span.priced = true} | sum_over_time(span.cost_usd) by (name)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "Cost",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Cost_q",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        },
        {
          "refId": "Unpriced_q",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.outcome = \"responded\" && span.priced = false} | count_over_time() by (name)",
          "metricsQueryType": "instant",
          "hide": true,
          "limit": 100
        },
        {
          "refId": "Unpriced",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Unpriced_q",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "displayName",
                "value": "Cost"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "Unpriced"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Unpriced requests"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
