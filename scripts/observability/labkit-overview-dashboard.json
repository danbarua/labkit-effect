          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        },
        {
          "refId": "cost",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=\"agent.model.request\" && span.${activity:text}_usd != nil} | sum_over_time(span.${activity:text}_usd) by (span.priced)",
          "metricsQueryType": "range",
          "step": "10m",
          "limit": 100
        }
