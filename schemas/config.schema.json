{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plugins": {
      "type": "object",
      "properties": {
        "loopBreaker": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "nudgeAt": {
                  "type": "integer",
                  "minimum": 1
                },
                "stopAt": {
                  "type": "integer",
                  "minimum": 1
                },
                "key": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "toolAndInput"
                      ]
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "default",
                    "acceptEdits",
                    "dontAsk",
                    "bypassPermissions"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "maxTurnRequests": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "retryIncomplete": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "retries": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "maxBudget": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "usd": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "usd"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "credentials": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pass": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "loopBreaker"
                ]
              },
              "nudgeAt": {
                "type": "integer",
                "minimum": 1
              },
              "stopAt": {
                "type": "integer",
                "minimum": 1
              },
              "key": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "toolAndInput"
                    ]
                  }
                ]
              }
            },
            "required": [
              "use"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "permissions"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "default",
                  "acceptEdits",
                  "dontAsk",
                  "bypassPermissions"
                ]
              }
            },
            "required": [
              "use"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "maxTurnRequests"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "use"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "retryIncomplete"
                ]
              },
              "retries": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "use"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "maxBudget"
                ]
              },
              "usd": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "use",
              "usd"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "credentials"
                ]
              },
              "pass": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "use"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxHolds": {
      "type": "integer",
      "minimum": 0
    },
    "mcpServers": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "stdio"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "connectTimeout": {
                    "type": "string"
                  }
                },
                "required": [
                  "command"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "http",
                      "sse"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "connectTimeout": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelRequests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "turnEnd": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knownModels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolSources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commandEnvironment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "context": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "output": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "input": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reasoning": {
                    "type": "boolean"
                  },
                  "efforts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "budget": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "min"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "view": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "thinking": {
              "type": "string",
              "enum": [
                "on",
                "off"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
