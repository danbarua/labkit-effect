{
  "name": "labkit-effect",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit -p .",
    "check": "bun run vidaimock:install && bun run typecheck && bun run lint && bun run check:brands && bun run check:rules && bun test",
    "vidaimock:install": "bun scripts/vidaimock.ts",
    "lint": "oxlint --type-aware --format default src tests scripts",
    "check:brands": "bun scripts/check-brands.ts",
    "check:rules": "bun scripts/check-rules.ts",
    "acp:logs": "bun scripts/acp-logs.ts",
    "cli": "bun run src/examples/cli-repl/index.ts",
    "models:refresh": "bun scripts/models/refresh.ts",
    "cli:watch": "bun --watch src/examples/cli-repl/index.ts",
    "vscode:dev": "bun scripts/vscode-dev.ts",
    "acp:dev": "bun src/agent-acp/main.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/tsgo": "^0.46.1",
    "@types/bun": "latest",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.0",
    "@effect/ai-openai": "4.0.0",
    "@effect/ai-openai-compat": "4.0.0",
    "@logtape/logtape": "^2.3.9",
    "effect": "^4.0.0",
    "effective-acp": "0.1.0"
  }
}
