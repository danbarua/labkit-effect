{
  "name": "labkit-effect",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "acp:dev": "bun src/agent-acp/main.ts",
    "acp:logs": "bun scripts/acp-logs.ts",
    "check": "bun run native:build && bun run native:test && bun run vidaimock:install && bun run typecheck && bun run lint && bun run check:brands && bun run check:schemas && bun test",
    "check:brands": "bun scripts/check-brands.ts",
    "check:schemas": "bun scripts/config-schema.ts --check",
    "cli": "bun run src/examples/cli-repl/index.ts",
    "cli:watch": "bun --watch src/examples/cli-repl/index.ts",
    "lint": "oxlint --type-aware --format default src tests scripts bin",
    "models:refresh": "bun scripts/models/refresh.ts",
    "observability:alerts": "bun scripts/observability/alert-rules.ts",
    "observability:captures": "bun scripts/observability/capture-server.ts",
    "observability:dashboards": "bun scripts/observability/import-dashboard.ts",
    "observability:datasources": "bun scripts/observability/datasources.ts",
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit -p .",
    "vidaimock:install": "bun scripts/vidaimock.ts",
    "vscode:dev": "bun scripts/vscode-dev.ts",
    "zork": "bun run src/examples/zork/index.ts",
    "zork:spectator": "bun run src/examples/zork-spectator/index.ts",
    "zork:spectator:scripted": "bun run src/examples/zork-spectator/scripted.ts",
    "native:build": "bun scripts/native.ts build",
    "native:test": "bun scripts/native.ts test"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/tsgo": "^0.46.1",
    "@types/bun": "latest",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.0",
    "@effect/ai-openai": "4.0.0",
    "@effect/ai-openai-compat": "4.0.0",
    "@logtape/logtape": "^2.3.9",
    "effect": "^4.0.0",
    "effective-acp": "0.2.1",
    "es-git": "^0.7.0",
    "yaml": "2.9.1"
  },
  "bin": {
    "labkit": "bin/labkit.ts"
  }
}
